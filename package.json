{
  "name": "mishmash",
  "version": "0.1.0",
  "description": "Safely synchronize skills and MCP server intent across coding-agent harnesses",
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "bin": {
    "mishmash": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "schemas",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build": "tsc && node scripts/executable.mjs",
    "test": "tsc -p tsconfig.test.json --noEmit false --outDir .test-dist && node scripts/test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ignore": "^7.0.5",
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.9.1",
    "toml-eslint-parser": "1.0.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.10",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BechirMakhlouf/mishmash.git"
  },
  "bugs": {
    "url": "https://github.com/BechirMakhlouf/mishmash/issues"
  },
  "homepage": "https://github.com/BechirMakhlouf/mishmash#readme"
}
